<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/aquarium_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐠 FishScanner"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сфотографируйте рыбку — она приплывёт в аквариум в браузере"
        android:textColor="#CFE8F9"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Адрес сервера (IP:порт)"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/serverAddressInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="192.168.1.10:8015"
        android:inputType="textUri"
        android:textColorHint="#8AA"
        android:textColor="@color/white"
        android:layout_marginTop="4dp" />

    <ImageView
        android:id="@+id/photoPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerInside"
        android:background="#0A2230"
        android:contentDescription="Предпросмотр фото рыбки" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/takePhotoButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📷 Снять" />

        <Button
            android:id="@+id/pickGalleryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="🖼️ Галерея" />
    </LinearLayout>

    <Button
        android:id="@+id/uploadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Отправить в аквариум"
        android:backgroundTint="@color/aquarium_blue"
        android:enabled="false" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#CFE8F9"
        android:textSize="13sp"
        android:gravity="center" />

</LinearLayout>
